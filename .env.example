# ---------- Supabase（正式模式） ----------
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# 新版 publishable key：可以公开，浏览器直传文件时用于 apikey 请求头
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxx
# 兼容旧版 Supabase：NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# 新版 secret key：只在服务端使用，切勿加 NEXT_PUBLIC_ 前缀
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxx
# 兼容旧版 Supabase：SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

SUPABASE_BUCKET=submissions

# ---------- 管理端 ----------
# 登录 /admin 使用的口令，建议 12 位以上
ADMIN_PASSWORD=change-me-please
# 用于给登录 Cookie 签名，建议 32 位以上随机字符
SESSION_SECRET=change-me-to-a-long-random-string

# ---------- 提交截止时间（可选） ----------
# 必须带时区；不填则页面显示“以群内通知为准”，服务端也不会自动截止
# NEXT_PUBLIC_DEADLINE=2026-11-20T23:59:59+08:00

# ---------- 本地演示 ----------
# 置为 1 时不连接 Supabase，数据写入 .data/ 目录（仅本地开发使用，Vercel 上无效）
# DEMO_MODE=1
